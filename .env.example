# ═══════════════════════════════════════════════
# ORION V2 — Environment Configuration
# ═══════════════════════════════════════════════

# ── AI Providers ──
# PRIMARY: Ollama runs locally — always used first
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3

# FALLBACK: Gemini API — only used if Ollama is unreachable
# Leave empty to run fully offline (Ollama only)
GEMINI_API_KEYS=["YOUR_GEMINI_KEY_1", "YOUR_GEMINI_KEY_2"]

# ── Voice / TTS ──
SARVAM_API_KEYS=["YOUR_SARVAM_KEY_1", "YOUR_SARVAM_KEY_2"]
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Hardware (Raspberry Pi / PC) ──
SPEAKER_CARD_INDEX=1
MIC_INDEX=
FACE_MODEL=hog

# ── Client ──
ORION_API_URL=http://localhost:8000
MATCH_THRESHOLD=0.55
