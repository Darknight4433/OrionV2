# ═══════════════════════════════════════════════
# ORION V2 — Environment Configuration
# ═══════════════════════════════════════════════

# ── AI Providers ──
# Gemini (Primary Cloud AI) — supports multiple keys for rotation
GEMINI_API_KEYS=["YOUR_GEMINI_KEY_1", "YOUR_GEMINI_KEY_2"]

# Ollama (Local AI — runs on same machine or LAN)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3

# OpenRouter (Cloud Fallback — when Gemini is exhausted)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct

# ── Voice / TTS ──
SARVAM_API_KEYS=["YOUR_SARVAM_KEY_1", "YOUR_SARVAM_KEY_2"]
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Hardware (Raspberry Pi / PC) ──
SPEAKER_CARD_INDEX=1
MIC_INDEX=
FACE_MODEL=hog

# ── Server ──
ORION_API_URL=http://localhost:8000
MATCH_THRESHOLD=0.55
