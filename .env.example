# ORION V2 — Example Config (copy to .env and fill keys)
# ═══════════════════════════════════════════════════════
# AI Chain: Groq → Gemini → Ollama (CPU fallback)
# ═══════════════════════════════════════════════════════

# ── PRIMARY: Groq (free, ~500ms) ──
# Get free key at: https://console.groq.com (no credit card)
# Add multiple keys for rotation: GROQ_API_KEYS=["key1","key2","key3"]
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_API_KEYS=[]
GROQ_MODEL=llama-3.1-8b-instant

# ── SECONDARY & SPECIALIST: Gemini (free tier, rotates on quota) ──
# Get keys at: https://aistudio.google.com/app/apikey
# You can supply individual keys or a JSON list:
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEYS=[]

# ── LOCAL INTELLIGENCE: Ollama (Primary local reasoning) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:latest

# ── VISION: Hugging Face VLM (Primary object & image understanding) ──
# Initial model target: Qwen/Qwen2.5-VL-3B-Instruct (hosted inference API)
HF_VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
HF_TOKEN_1=hf_your_first_authorized_token_here
HF_TOKEN_2=
HF_TOKEN_3=
HF_TOKENS=[]
VISION_PROVIDER=huggingface
VISION_FALLBACK_PROVIDER=gemini
CAMERA_DEVICE=0
VISION_CAPTURE_DELAY=1.5
VISION_MAX_REQUESTS=5
VISION_TIMEOUT=15.0

# ── CURRENT INFORMATION & FALLBACK: Gemini ──
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_API_KEYS=["YOUR_GEMINI_KEY_1"]

# ── FAST CLOUD INFERENCE: Groq ──
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_API_KEYS=[]
GROQ_MODEL=llama-3.1-8b-instant

# ── Client ──
ORION_API_URL=http://localhost:8000
MATCH_THRESHOLD=0.55
MIC_INDEX=
FACE_MODEL=hog

# Pi 3 only — point to Windows/Pi4 brain IP
# ORION_API_URL=http://192.168.1.X:8000
