# ═══════════════════════════════════════
# ORION V2 — Example Config
# Copy this to .env and fill in your keys
# ═══════════════════════════════════════

# AI — Ollama (local, primary for simple queries)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:latest

# AI — Gemini (fallback / complex queries)
# Get key from https://aistudio.google.com/app/apikey
GEMINI_API_KEYS=["YOUR_GEMINI_KEY"]

# TTS — edge-tts is default (free, no key needed)
# Add ElevenLabs only if you have a paid plan
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Client
ORION_API_URL=http://localhost:8000
MATCH_THRESHOLD=0.55
MIC_INDEX=
FACE_MODEL=hog

# Pi 3 only — set to Pi 4 / Windows IP
# ORION_API_URL=http://192.168.1.X:8000
