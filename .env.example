# ORION V2 — Example Config (copy to .env and fill keys)

# PRIMARY AI — Groq (free, fast ~500ms on LPU)
# Get free key at: https://console.groq.com (no credit card)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

# FALLBACK — Gemini (when Groq quota hits)
GEMINI_API_KEYS=["YOUR_GEMINI_KEY"]

# LAST RESORT — Ollama (local CPU, slow without GPU)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:latest

# Client
ORION_API_URL=http://localhost:8000
MATCH_THRESHOLD=0.55
MIC_INDEX=
FACE_MODEL=hog

# Pi 3 only — point to Windows/Pi4 IP
# ORION_API_URL=http://192.168.1.X:8000
